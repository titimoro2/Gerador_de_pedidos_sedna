# ========================================================
# CONFIGURAÇÕES DO SERVIDOR & BANCO DE DADOS MYSQL 5.7
# ========================================================
# O sistema funciona 100% sem o banco de dados caso você
# queira operar apenas em arquivos locais.
# Quando configurado, o MySQL 5.7 atua como BACKUP/RÉPLICA
# automática em segundo plano para proteção contra perda de dados.
# ========================================================

# Porta do servidor web (padrão: 443 para HTTPS / Cloudflare Tunnel / Proxy)
PORT=443

# Ativar sincronização com MySQL (true / false)
# Se false, opera 100% offline em arquivos sem conectar ao MySQL
DB_ENABLED=false

# Host do banco de dados MySQL 5.7
DB_HOST=localhost

# Porta do MySQL (padrão: 3306)
DB_PORT=3306

# Nome do banco de dados
DB_NAME=sedna_pedidos

# Usuário do MySQL
DB_USER=root

# Senha do usuário do MySQL
DB_PASSWORD=

# Sincronização automática em segundo plano ao salvar arquivos (true / false)
DB_AUTO_SYNC=true
