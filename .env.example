# ============================================================================
# SEDNA GROUP - GERADOR DE PEDIDOS & CONTROLE DE PONTO RH (APPSEC .ENV.EXAMPLE)
# ============================================================================
# Copie este arquivo para `.env` e preencha com os segredos reais do servidor.
# NUNCA faça commit do arquivo `.env` no GitHub.
# ============================================================================

# Ambiente de execução (development | production)
NODE_ENV=production

# Portas do Servidor Node.js
# Quando atrás do Proxy Reverso Nginx, recomenda-se HTTP_PORT=3000 e HTTPS_PORT=0
HTTP_PORT=3000
HTTPS_PORT=443
PORT=443
TRUST_PROXY=1

# Segurança de Sessão, Cookies e Senhas (Bcrypt)
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=true
BCRYPT_SALT_ROUNDS=12
CORS_ALLOWED_ORIGINS=https://pedidos.sednagroup.com.br,http://localhost:3000

# Senhas iniciais para bootstrap (apenas caso data/users.json ainda não exista)
# Serão automaticamente criptografadas com Bcrypt na inicialização
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASS
DEFAULT_USER_PASSWORD=CHANGE_ME_INITIAL_USER_PASS

# ============================================================================
# CONEXÃO MYSQL 5.7 PRINCIPAL - SISTEMA COMERCIAL (MENOR PRIVILÉGIO)
# Importante: O MySQL deve operar em 127.0.0.1 (bind-address = 127.0.0.1)
# NUNCA utilize o usuário 'root' na aplicação. Use o usuário de 'setup-security.sql'.
# ============================================================================
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sedna_pedidos
DB_USER=sedna_app
DB_PASSWORD=CHANGE_ME_STRONG_APP_DB_PASSWORD
DB_AUTO_SYNC=true

# ============================================================================
# MÓDULO RH - LOGIN 1: BANCO DA CATRACA iD CONTROL (ESTRITAMENTE SOMENTE LEITURA)
# Usuário com permissão exclusiva de SELECT no banco `acesso`
# ============================================================================
RH_DB_ENABLED=false
RH_DB_TYPE=mysql
RH_DB_HOST=127.0.0.1
RH_DB_PORT=3306
RH_DB_NAME=acesso
RH_DB_USER=rh_leitura
RH_DB_PASSWORD=CHANGE_ME_READONLY_IDCONTROL_PASSWORD
RH_WORKDAY_MINUTES=528
RH_DEFAULT_LUNCH_MINUTES=60

# ============================================================================
# MÓDULO RH - LOGIN 2: BANCO COMERCIAL PARA GRAVAÇÃO DE AJUSTES/VIAGENS DO RH
# Usuário com permissão apenas de SELECT, INSERT, UPDATE, DELETE em sedna_pedidos
# ============================================================================
RH_COMM_DB_ENABLED=true
RH_COMM_DB_HOST=127.0.0.1
RH_COMM_DB_PORT=3306
RH_COMM_DB_NAME=sedna_pedidos
RH_COMM_DB_USER=sedna_app
RH_COMM_DB_PASSWORD=CHANGE_ME_STRONG_APP_DB_PASSWORD
