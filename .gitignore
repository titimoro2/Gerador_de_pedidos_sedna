# Dependências (nunca devem ir para o GitHub)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Configurações de ambiente locais (senhas do banco de dados e credenciais)
.env
*.env
*.env.*
data/db-config.json
data/db-config*.json
data/backups_locais/
data/backups/

# Sessões temporárias ativas e dados locais de usuários/propostas
data/sessions.json
data/users.json
data/active-proposals/
*.lnk

# Arquivos de log e temporários do sistema operacional
*.log
.DS_Store
Thumbs.db

# Configurações de editores/IDEs e ambientes virtuais
.vscode/
.idea/
.venv/
venv/

# Instaladores e binários
*.exe
