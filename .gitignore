# Dependências (nunca devem ir para o GitHub)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Configurações de ambiente locais (senhas do banco de dados)
.env
data/db-config.json

# Sessões temporárias ativas
data/sessions.json

# Arquivos de log e temporários do sistema operacional
*.log
.DS_Store
Thumbs.db

# Configurações de editores/IDEs e ambientes virtuais
.vscode/
.idea/
.venv/
venv/

# Instaladores e binários
*.exe
